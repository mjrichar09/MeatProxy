<Project Sdk="Microsoft.NET.Sdk">

  <!--
    E1's exit criterion is a house you can move through in a test harness,
    saved and restored. This is that harness. It draws nothing and it is not
    the game: Godot is the shell, and it comes later (ADR 0028).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeatProxy.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MeatProxy.Core/MeatProxy.Core.csproj" />
  </ItemGroup>

</Project>
